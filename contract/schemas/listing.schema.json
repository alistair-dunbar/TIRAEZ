{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract.tiraez.invalid/v2/listing.schema.json",
  "title": "Listing",
  "description": "One property, filled by Part A from the agency's feed every refresh. The AI may only state facts found here.",
  "type": "object",
  "required": [
    "ref", "agency_id", "status", "completion", "type", "town", "area", "price", "currency",
    "beds", "baths", "built_m2", "plot_m2", "features", "url", "summary_en", "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "ref": { "$ref": "common.schema.json#/$defs/listing_ref" },
    "agency_id": { "$ref": "common.schema.json#/$defs/agency_id" },
    "status": {
      "type": "string",
      "enum": ["available", "reserved", "sold"],
      "description": "Never claim availability for anything but available."
    },
    "completion": {
      "type": "string",
      "enum": ["ready", "off_plan"],
      "description": "off_plan means sold before or during construction, common in Dubai and in Spanish new builds."
    },
    "handover": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
      "description": "Expected handover month for off_plan listings (YYYY-MM), as given by the developer. Say it is the developer's estimate."
    },
    "payment_plan": {
      "type": ["string", "null"],
      "maxLength": 200,
      "description": "The developer's payment plan as written in the feed, for example '60/40: 60% during construction, 40% on handover'. Read it as given; never calculate instalments."
    },
    "developer": { "type": ["string", "null"], "maxLength": 120 },
    "permit_number": {
      "type": ["string", "null"],
      "maxLength": 40,
      "description": "Advertising permit number where the market requires one (for example a DLD/RERA permit in Dubai). Give it if asked."
    },
    "type": {
      "type": "string",
      "enum": ["villa", "apartment", "penthouse", "townhouse", "plot", "other"]
    },
    "town": { "type": "string", "minLength": 1 },
    "area": { "type": "string", "minLength": 1 },
    "price": { "$ref": "common.schema.json#/$defs/money" },
    "currency": { "$ref": "common.schema.json#/$defs/currency" },
    "beds": { "type": "integer", "minimum": 0 },
    "baths": { "type": "integer", "minimum": 0 },
    "built_m2": { "type": "integer", "minimum": 0, "description": "Always square metres. Part A converts feeds that use square feet." },
    "plot_m2": { "type": ["integer", "null"], "minimum": 0 },
    "features": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "url": { "type": "string", "format": "uri" },
    "summary_en": { "type": "string", "minLength": 1, "maxLength": 400 },
    "updated_at": { "$ref": "common.schema.json#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": { "properties": { "completion": { "const": "off_plan" } } },
      "then": { "required": ["handover", "payment_plan", "developer"] }
    }
  ]
}
