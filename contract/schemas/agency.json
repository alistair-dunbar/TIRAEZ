{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agency",
  "description": "Agency settings. Returned by GET /agency/{id}.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "agency_name",
    "agency_location",
    "agent_name",
    "region",
    "currency",
    "timezone",
    "supported_languages",
    "fallback_language",
    "summary_language",
    "tone",
    "max_reply_words",
    "booking_link",
    "ai_disclosure",
    "legal_footer",
    "handoff_topics",
    "faqs",
    "agents",
    "office_hours",
    "feed"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "agency_name": {
      "type": "string"
    },
    "agency_location": {
      "type": "string"
    },
    "agent_name": {
      "type": "string",
      "description": "Name of the default agent used in replies"
    },
    "region": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "timezone": {
      "type": "string",
      "description": "IANA time zone, e.g. Europe/Madrid"
    },
    "supported_languages": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2}$",
        "description": "ISO 639-1 code, e.g. de"
      }
    },
    "fallback_language": {
      "type": "string",
      "pattern": "^[a-z]{2}$",
      "description": "ISO 639-1 code, e.g. de"
    },
    "summary_language": {
      "type": "string",
      "pattern": "^[a-z]{2}$",
      "description": "Language of the agent summary"
    },
    "tone": {
      "type": "string"
    },
    "max_reply_words": {
      "type": "integer",
      "minimum": 1
    },
    "booking_link": {
      "type": "string"
    },
    "ai_disclosure": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "First sentence of every reply (or opening line of every call), per language"
    },
    "legal_footer": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "handoff_topics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Topics the AI must not answer: hand to a human"
    },
    "faqs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "q",
          "a"
        ],
        "additionalProperties": false,
        "properties": {
          "q": {
            "type": "string"
          },
          "a": {
            "type": "string"
          }
        }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "phone",
          "languages"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z]{2}$",
              "description": "ISO 639-1 code, e.g. de"
            }
          }
        }
      }
    },
    "office_hours": {
      "type": "object",
      "description": "[open, close] pairs per weekday in the agency's time zone. Empty array = closed.",
      "additionalProperties": false,
      "required": [
        "mon",
        "tue",
        "wed",
        "thu",
        "fri",
        "sat",
        "sun"
      ],
      "properties": {
        "mon": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string",
              "pattern": "^[0-2][0-9]:[0-5][0-9]$"
            }
          }
        },
        "tue": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string",
              "pattern": "^[0-2][0-9]:[0-5][0-9]$"
            }
          }
        },
        "wed": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string",
              "pattern": "^[0-2][0-9]:[0-5][0-9]$"
            }
          }
        },
        "thu": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string",
              "pattern": "^[0-2][0-9]:[0-5][0-9]$"
            }
          }
        },
        "fri": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string",
              "pattern": "^[0-2][0-9]:[0-5][0-9]$"
            }
          }
        },
        "sat": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string",
              "pattern": "^[0-2][0-9]:[0-5][0-9]$"
            }
          }
        },
        "sun": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string",
              "pattern": "^[0-2][0-9]:[0-5][0-9]$"
            }
          }
        }
      }
    },
    "feed": {
      "type": "object",
      "required": [
        "format",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "kyero"
          ]
        },
        "url": {
          "type": "string"
        }
      }
    }
  }
}
