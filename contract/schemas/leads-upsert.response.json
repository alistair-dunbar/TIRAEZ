{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "leads-upsert.response",
  "description": "201 when created, 200 when an existing lead was updated.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lead_id",
    "created",
    "lead"
  ],
  "properties": {
    "lead_id": {
      "type": "string"
    },
    "created": {
      "type": "boolean"
    },
    "lead": {
      "$ref": "lead.json"
    }
  }
}
