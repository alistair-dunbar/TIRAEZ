{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract.tiraez.invalid/v1/agency.schema.json",
  "title": "Agency settings",
  "description": "One agency.json per agency. Part A stores it; both halves read it through GET /agency/{agency_id}.",
  "type": "object",
  "required": [
    "agency_id", "name", "timezone", "languages", "office_hours", "agents",
    "feed", "channels", "faq", "handoff_topics", "tone", "disclosure"
  ],
  "additionalProperties": false,
  "properties": {
    "agency_id": { "$ref": "common.schema.json#/$defs/agency_id" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "timezone": { "type": "string", "const": "Europe/Madrid" },
    "languages": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/language" },
      "minItems": 1,
      "uniqueItems": true
    },
    "office_hours": {
      "type": "object",
      "description": "Local time in the agency's timezone. An empty list means closed that day.",
      "required": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"],
      "additionalProperties": false,
      "patternProperties": {
        "^(mon|tue|wed|thu|fri|sat|sun)$": {
          "type": "array",
          "items": { "$ref": "#/$defs/time_range" }
        }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/agent" }
    },
    "feed": {
      "type": "object",
      "required": ["type", "url", "refresh_minutes"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["kyero_xml", "resales_online", "inmobalia", "csv"] },
        "url": { "type": "string", "format": "uri" },
        "refresh_minutes": { "type": "integer", "minimum": 15, "maximum": 1440 }
      }
    },
    "channels": {
      "type": "object",
      "required": ["email", "whatsapp", "phone"],
      "additionalProperties": false,
      "properties": {
        "email": { "type": "boolean" },
        "whatsapp": { "type": "boolean" },
        "phone": { "type": "boolean" }
      }
    },
    "phone": {
      "type": "object",
      "description": "Required when channels.phone is true. Owned by Part B.",
      "required": ["ai_number", "transfer_timeout_s", "recording_retention_days", "included_minutes"],
      "additionalProperties": false,
      "properties": {
        "ai_number": { "$ref": "common.schema.json#/$defs/phone" },
        "transfer_timeout_s": { "type": "integer", "minimum": 10, "maximum": 60 },
        "recording_retention_days": { "type": "integer", "minimum": 0, "maximum": 90 },
        "included_minutes": { "type": "integer", "minimum": 0 }
      }
    },
    "faq": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["q", "a"],
        "additionalProperties": false,
        "properties": {
          "q": { "type": "string", "minLength": 1 },
          "a": { "type": "string", "minLength": 1 }
        }
      }
    },
    "handoff_topics": {
      "type": "array",
      "description": "Topics the AI never answers. It hands them to a person.",
      "items": {
        "type": "string",
        "enum": ["legal", "tax", "mortgage", "negotiation", "complaint", "valuation_price"]
      },
      "uniqueItems": true
    },
    "tone": { "type": "string", "maxLength": 200 },
    "disclosure": {
      "type": "object",
      "description": "The fixed AI disclosure line per language (EU AI Act art. 50). The prompt may not change it.",
      "required": ["en", "es"],
      "propertyNames": { "$ref": "common.schema.json#/$defs/language" },
      "additionalProperties": { "type": "string", "minLength": 10 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "channels": { "properties": { "phone": { "const": true } } } } },
      "then": { "required": ["phone"] }
    }
  ],
  "$defs": {
    "time_range": {
      "type": "array",
      "prefixItems": [
        { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
        { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "agent": {
      "type": "object",
      "required": ["agent_id", "name", "mobile", "email", "summary_language", "on_duty"],
      "additionalProperties": false,
      "properties": {
        "agent_id": { "$ref": "common.schema.json#/$defs/agent_id" },
        "name": { "type": "string", "minLength": 1 },
        "mobile": { "$ref": "common.schema.json#/$defs/phone" },
        "email": { "$ref": "common.schema.json#/$defs/email" },
        "summary_language": { "$ref": "common.schema.json#/$defs/language" },
        "on_duty": { "type": "boolean", "description": "The agent who gets live transfers. Exactly one should be true." }
      }
    }
  }
}
