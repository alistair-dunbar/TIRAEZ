{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "leads-events.request",
  "description": "Adds an event to a lead's log. The first message_out sets first_reply_at. opt_out suppresses the lead. handoff sets status needs_human.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "channel"
  ],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "message_in",
        "message_out",
        "draft_ready",
        "call_started",
        "call_ended",
        "handoff",
        "opt_out",
        "note"
      ]
    },
    "channel": {
      "type": "string",
      "enum": [
        "email",
        "portal",
        "web",
        "whatsapp",
        "phone"
      ]
    },
    "at": {
      "type": "string",
      "description": "ISO 8601. Defaults to now."
    },
    "body": {
      "type": [
        "string",
        "null"
      ],
      "description": "Message text, call summary or note"
    },
    "meta": {
      "type": "object",
      "description": "Free-form extras, e.g. transcript, recording_url, duration_s"
    }
  }
}
