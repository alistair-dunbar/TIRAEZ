{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lead-event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "lead_id",
    "type",
    "channel",
    "at",
    "body",
    "meta"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evt_"
    },
    "lead_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "message_in",
        "message_out",
        "draft_ready",
        "call_started",
        "call_ended",
        "handoff",
        "opt_out",
        "note"
      ]
    },
    "channel": {
      "type": "string",
      "enum": [
        "email",
        "portal",
        "web",
        "whatsapp",
        "phone"
      ]
    },
    "at": {
      "type": "string"
    },
    "body": {
      "type": [
        "string",
        "null"
      ]
    },
    "meta": {
      "type": "object"
    }
  }
}
