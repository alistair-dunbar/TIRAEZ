# Copy to .env for local use (never commit .env). On Railway, set these under Variables.
# Every setting is optional: with none set, the site runs with generation and payments switched
# off, and says so to customers.

# Video generation (fal.ai, Kling v4 image-to-video; about $0.235 per second of 1080p video)
# ENGINE=fal
# FAL_KEY=...                       (or FAL_AUTH=proxy where an outbound proxy adds the key)
# GENERATION_BUDGET_USD=50          (optional safety cap on estimated provider spend, all customers together)

# Payments (off unless set)
# PAYMENTS=moyasar
# MOYASAR_SECRET_KEY=sk_test_...    (production refuses test keys)
# APP_URL=https://your-domain.example   (required with Moyasar)

# Account emails: confirmation, password reset, email-change notices (off in production unless set;
# sign-ups stay closed without it). Outside production, unset means the sandbox outbox in DATA_DIR/outbox.
# MAIL=resend
# RESEND_API_KEY=re_...             (Resend dashboard > API Keys; sending access only)
# MAIL_FROM=Tiraez <account@mail.your-domain.example>   (an address on a domain verified in Resend)
# MAIL_REPLY_TO=support@your-domain.example             (optional)
# APP_URL=https://www.your-domain.example               (required: every link in an email starts with it)

# Storage
# DB_PATH=data/app.db
# DATA_DIR=data                     (photos and finished videos; a persistent volume in production)

# Test-only stand-ins, refused when NODE_ENV=production:
#   ENGINE=mock (needs NODE_ENV=test)   PAYMENTS=test   MAIL=outbox
