# Copy to .env for local use (never commit .env). On Railway, set these under Variables.

# Local development: free sample videos and test payments.
PAYMENTS=test
ENGINE=mock

# Production (all four required):
# NODE_ENV=production            (set by the Dockerfile)
# APP_URL=https://your-domain.example
# PAYMENTS=moyasar
# MOYASAR_SECRET_KEY=sk_live_...   (sk_test_... while testing; production refuses test keys)
# ENGINE=fal                     (real videos, about $0.79 each) or mock (sample videos only)
# FAL_KEY=...                    (needed when ENGINE=fal)
# BUDGET_USD=5                   (hard cap on total fal.ai spending; raise it deliberately)
