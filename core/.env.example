# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...
# Fast, low-cost default. Any current Claude model ID works.
ANTHROPIC_MODEL=claude-haiku-5-5
PORT=3000
# Which agency config to load (file in config/)
AGENCY_CONFIG=config/agency.demo.json
# Uncomment to run without an API key: pre-written replies for the 5 samples.
# Not AI output - do not use for the sales video.
# DEMO_MODE=offline
