# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...
# Fast, low-cost default. Any current Claude model ID works.
ANTHROPIC_MODEL=claude-haiku-5-5
PORT=3000
# Which agency config to load (file in config/)
AGENCY_CONFIG=config/agency.demo.json
# Uncomment to run without an API key: pre-written replies for the 5 samples.
# Not AI output - do not use for the sales video.
# DEMO_MODE=offline
# Online only: the browser asks for this password before showing the demo page.
# DEMO_PASSWORD=
# Postgres connection. Render sets this from the managed database; leave unset locally.
# DATABASE_URL=postgres://user:password@host:5432/dbname
